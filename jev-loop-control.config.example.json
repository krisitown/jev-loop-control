{
  "version": 1,
  "mode": "enforce",
  "jev": {
    "enabled": true,
    "endpoint": "https://ai-gateway.vercel.sh/typesafe/v1/systemone",
    "model": "typesafe-ai/jev",
    "apiKeyEnv": "AI_GATEWAY_API_KEY",
    "deadlineMs": 10000,
    "maxRequestBytes": 131072
  },
  "limits": {
    "maxInterventionsPerTask": null,
    "maxTerminalContinuations": 2
  },
  "tuning": {
    "enabled": false,
    "selector": "s2",
    "softPayloadBytes": 24576,
    "softThreshold": 0.62,
    "strongThreshold": 0.84,
    "softMinGap": 0.12,
    "strongMinGap": 0.24,
    "proposalEvery": 1,
    "completionEnabled": true,
    "cooldownCheckpoints": 0
  },
  "trace": {
    "dir": null,
    "artifacts": true
  },
  "taskManifestPath": null
}
